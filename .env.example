# SQLite works without an account. Relative paths resolve from the project root.
DATABASE_URL=sqlite:///storage/items.db
# AILT9019 Group 19 sponsored Bailian access (expires 19 November 2026).
# Store the real key only in ignored .env or Render environment settings.
LLM_API_KEY=
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash
LLM_PROVIDER=Qwen
LLM_TIMEOUT_SECONDS=30
LLM_REQUESTS_PER_MINUTE=10

# Seed examples only once on a new database; use false for an empty new inventory.
SEED_DEMO_DATA=true
# Optional approved Microsoft Entra OIDC (requires university registration).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
AUTH_COOKIE_SECRET=
AUTH_REDIRECT_URI=https://campus-find-g19.onrender.com/oauth2callback
